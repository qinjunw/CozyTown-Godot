config_version=5

[application]

config/name="CozyTown Toolchain"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]

window/size/viewport_width=800
window/size/viewport_height=560
window/size/window_width_override=800
window/size/window_height_override=560
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="CozyTown.Game"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.059, 0.078, 0.09, 1)
